{
  "name": "cifar-journey-film",
  "version": "1.0.0",
  "private": true,
  "description": "Narrated Remotion film explaining the CIFAR-10 experiment journey",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts CifarJourney --concurrency=2",
    "render": "remotion render src/index.ts CifarJourney out/cifar-journey.mp4 --codec=h264 --concurrency=4 --gl=swiftshader",
    "render:720": "remotion render src/index.ts CifarJourney out/cifar-journey-720p.mp4 --codec=h264 --scale=0.6667 --concurrency=4 --gl=swiftshader"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
